    "html-to-text": "10.0.0",
    "imapflow": "^1.4.2",
    "mailparser": "^3.9.11",
    "minisearch": "^7.2.0",
    "nodemailer": "^9.0.1",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "2.16.1",
    "typescript": "^5.6.0"
  }
