{
  "functions": [
    {
      "source": "functions",
      "codebase": "mixmaxclone-emulator",
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/block-deploy.mjs\""
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/block-deploy.mjs\""
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
