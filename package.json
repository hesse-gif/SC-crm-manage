{
  "name": "mixmaxclone",
  "version": "0.1.0",
  "private": true,
  "description": "Handle automatically handles recurring email with reviewed case policies",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "dev:live": "node scripts/run-next.mjs dev --live",
    "dev:emu": "node scripts/run-next.mjs dev --emulator",
    "build": "node scripts/run-next.mjs build --emulator",
    "build:live": "node scripts/run-next.mjs build --live",
    "start": "node scripts/run-next.mjs start",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node scripts/test-chat.mjs",
    "verify:node-lane": "node scripts/test-chat.mjs",
    "verify:e2e": "node scripts/verify-chat-e2e.mjs",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only auth,functions,firestore --project demo-flu",
    "configure:live": "node scripts/configure-live.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "build:hosting": "node scripts/run-next.mjs build --live --export",
    "deploy:hosting": "node scripts/deploy-hosting.mjs",
    "build:runtime": "node scripts/build-mixmax-functions.mjs",
    "test:mixmax": "node scripts/build-mixmax-functions.mjs && node --test --test-concurrency=1 tests/mixmax-import.test.mjs tests/mixmax-reconcile-messages.test.mjs tests/mixmax-finalize-import.test.mjs tests/mixmax-runtime.test.mjs tests/mixmax-automation.test.mjs tests/mixmax-send-guard.test.mjs",
    "import:flu": "node scripts/mixmax-import-flu.mjs",
    "dev:mixmax": "NEXT_PUBLIC_MIXMAX_INDEPENDENT=1 NEXT_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5401 NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9499 NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8480 node scripts/run-next.mjs dev --emulator",
    "deploy:runtime": "node scripts/deploy-mixmax.mjs"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "html-to-image": "^1.11.13",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    },
    "protobufjs": "7.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "15.19.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
